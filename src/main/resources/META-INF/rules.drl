package org.jahia.modules.jcontent.rules

// Stores the IPTC metadata of an uploaded image on the file node, as properties of jmix:iptc
// (see META-INF/definitions.cnd).
//
// Nothing here does the reading: Jahia already extracts IPTC on upload, because it parses JPEG
// with Tika's JpegParser, which runs metadata-extractor and emits every IPTC tag under its display
// name. Those values reach the rule engine as ExtractedVariable facts, and core simply discards the
// ones its own mapping table does not name - which is all of the IPTC ones. These rules pick them
// up by name, so no change to Jahia core is needed.
//
// One rule per field is the only option here: the DSL can match a metadata field by name, but has
// no consequence able to resolve a name to a property, which is what core's mapping table does in
// Java for EXIF.

// list any import classes here.
import org.jahia.services.content.rules.*
import org.slf4j.Logger

// declare any global variables here
global User user
global Service service
global Logger logger

rule "Store the IPTC Object Name of an uploaded image"
    salience 10
    when
        A file content has been modified
        The metadata field "Object Name" identified by iptcValue has been extracted
    then
        Add the type jmix:iptc
        Set the property j:iptcObjectName of the node with the value of iptcValue
end

