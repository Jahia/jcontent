<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!--
        Declaring the bean is all that is needed: Jahia's extension registry picks up beans of type
        DefaultEventListener from a module context and registers them with the JCR store, the same way
        it picks up actions and choice list initializers.

        Registered on the default workspace only. Metadata is read when an author uploads a file, and
        the resulting properties travel to live with the node when it is published, so reading it
        again there would be redundant work on content that cannot change.
    -->
    <bean class="org.jahia.modules.jcontent.media.ImageIptcMetadataListener">
        <property name="workspace" value="default"/>
    </bean>
</beans>
